{
  "formTitle": "CourtPerforma AI - Case Entry",
  "formSchema": {
    "adminDetails": {
      "f1_category": {
        "label": "1. Category",
        "type": "select",
        "allowCustom": true,
        "options": [
          "A482 (Application U/S 482)",
          "528 (BNS/BNSS Quashing)",
          "Bail Application",
          "Anticipatory Bail",
          "Civil Writ Petition",
          "Habeas Corpus",
          "Others"
        ]
      },
      "f2_bench": {
        "label": "2. Cognizable by",
        "type": "select",
        "allowCustom": true,
        "options": [
          "Single Judge",
          "Division Bench",
          "Larger Bench",
          "Others"
        ]
      },
      "f3_district": {
        "label": "3. District",
        "type": "select",
        "allowCustom": true,
        "options": [
          "Agra", "Aligarh", "Prayagraj (Allahabad)", "Kanpur Nagar", 
          "Lucknow", "Meerut", "Varanasi", "Others"
        ]
      }
    },
    "petitionerProfiles": {
      "f4_petitioner_name": {
        "label": "4. Petitioner / Appellant / Applicant",
        "type": "text"
      },
      "f4_age": {
        "label": "Petitioner Age",
        "type": "number"
      },
      "f4_gender": {
        "label": "Petitioner Gender",
        "type": "select",
        "allowCustom": false,
        "options": ["Male", "Female", "Other"]
      },
      "f4_mobile": {
        "label": "Petitioner Mobile",
        "type": "text"
      },
      "f4_email": {
        "label": "Petitioner E-Mail",
        "type": "email"
      }
    },
    "respondentProfiles": {
      "f5_respondent_name": {
        "label": "5. Respondent Name / Authority",
        "type": "text"
      },
      "f5_age": {
        "label": "Respondent Age",
        "type": "number"
      },
      "f5_gender": {
        "label": "Respondent Gender",
        "type": "select",
        "allowCustom": false,
        "options": ["Male", "Female", "Other"]
      },
      "f5_mobile": {
        "label": "Respondent Mobile",
        "type": "text"
      },
      "f5_email": {
        "label": "Respondent E-Mail",
        "type": "email"
      }
    },
    "counselAndFees": {
      "f6_petAdv": {
        "label": "6. Petitioner’s Advocate Name & Roll No.",
        "type": "text"
      },
      "f7_resAdv": {
        "label": "7. Respondent’s Advocate Name & Roll No.",
        "type": "text"
      },
      "f8_notice": {
        "label": "8. Notice No. (If any)",
        "type": "text"
      },
      "f9_fee": {
        "label": "9. Court Fee Paid",
        "type": "text"
      },
      "f10_affidavits": {
        "label": "10. No. of Affidavits attached",
        "type": "number"
      }
    },
    "crimeDetails": {
      "f11_crimeNo": {
        "label": "11. Crime No. & Year (If Any)",
        "type": "text"
      },
      "f12_section": {
        "label": "12. Under Section",
        "type": "text"
      },
      "f13_station": {
        "label": "13. Police Station & District",
        "type": "text"
      }
    },
    "lowerCourtDetails": {
      "f14_lcCase": {
        "label": "14. Lower Court Case No. Details",
        "type": "text"
      },
      "f15_lcDate": {
        "label": "15. Lower Court Order Date",
        "type": "date"
      },
      "f16_lcJudge": {
        "label": "16. Lower Court Order Passed By",
        "type": "text"
      }
    },
    "extraParties": {
      "f17_exPet": {
        "label": "17. Extra Parties (Petitioner)",
        "type": "text"
      },
      "f18_exRes": {
        "label": "18. Extra Parties (Respondent)",
        "type": "text"
      },
      "f19_exPetAdv": {
        "label": "19. Extra Advocates (Petitioner)",
        "type": "text"
      },
      "f20_exResAdv": {
        "label": "20. Extra Advocates (Respondent)",
        "type": "text"
      }
    },
    "actsAndVires": {
      "f21_actTitle": {
        "label": "21. Title of Act involved (Center/State)",
        "type": "text"
      },
      "f22_sections": {
        "label": "22. Sections",
        "type": "text"
      },
      "f23_ruleTitle": {
        "label": "23. Title of Rule involved",
        "type": "text"
      },
      "f24_viresAct": {
        "label": "24(i). Vires of Acts challenged (Yes/No) Act",
        "type": "text"
      },
      "f24_viresRule": {
        "label": "Rule challenged",
        "type": "text"
      },
      "f24_similarCases": {
        "label": "24(ii). Cases involving similar challenge",
        "type": "text"
      }
    },
    "submissionRemarks": {
      "f25_remarks": {
        "label": "25. Remarks (if any)",
        "type": "text"
      },
      "f26_advSignature": {
        "label": "Advocate’s Name (For Signature Block)",
        "type": "text"
      }
    },
    "officeUseOnly": {
      "stamp_cnr": {
        "label": "CNR No. (Unique ID)",
        "type": "text"
      },
      "stamp_date": {
        "label": "Date of Reporting",
        "type": "date"
      },
      "stamp_reporter": {
        "label": "Reporter Name",
        "type": "text"
      }
    }
  }
}
